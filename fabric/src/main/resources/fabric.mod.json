{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name_json}",
  "description": "${mod_description_json}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xczl.recursivecraft.fabric.RecursiveCraftFabric"
    ],
    "jei_mod_plugin": [
      "xczl.recursivecraft.compat.jei.RecursiveCraftJeiPlugin"
    ]
  },
  "mixins": [
    "recursivecraft.mixins.json",
    "recursivecraft-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric": "*",
    "minecraft": ">=1.21.8 <1.22",
    "architectury": ">=17.0.8"
  },
  "suggests": {
    "jei": "*"
  }
}
